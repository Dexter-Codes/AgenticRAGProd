{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Chunking": {
    "MaxTokens": 512,
    "OverlapTokens": 64
  },
  "AllowedHosts": "*",
  "Sqlite": {
    "DatabasePath": "App_Data/chat.db",
    "CommandTimeoutSeconds": 30
  }
}
