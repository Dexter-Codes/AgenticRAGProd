{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build API (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AgenticRAGProd.Api/AgenticRAGProd.Api.csproj",
        "--configuration",
        "Debug",
        "-m:1",
        "-nodeReuse:false",
        "-p:UseSharedCompilation=false",
        "-p:NuGetAudit=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
